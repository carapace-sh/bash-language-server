{
  "private": true,
  "version": "5.7.0",
  "scripts": {
    "clean": "rm -rf *.log */*.log */out node_modules",
    "build": "cd server && bun build --compile --target node --outfile bash-language-server src/cli.ts",
    "test": "bun test --isolate",
    "test:coverage": "bun test --isolate --coverage"
  },
  "devDependencies": {
    "@types/fuzzy-search": "2.1.5",
    "@types/jest": "29.5.14",
    "@types/node": "22.15.29",
    "@types/node-fetch": "2.6.13",
    "@types/turndown": "5.0.6",
    "@types/urijs": "1.19.26",
    "jest": "29.7.0",
    "tiny-editorconfig": "^1.0.2",
    "ts-jest": "29.4.5",
    "vscode-languageserver": "8.0.2",
    "vscode-languageserver-textdocument": "1.0.12"
  },
  "resolutions": {
    "@types/vscode": "1.106.1"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bash-lsp/bash-language-server.git"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "clearMocks": true,
    "moduleFileExtensions": [
      "js",
      "json",
      "node",
      "ts"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/server/out"
    ],
    "transform": {
      "\\.ts$": [
        "ts-jest"
      ]
    },
    "moduleNameMapper": {
      "^tiny-editorconfig$": "<rootDir>/__mocks__/tiny-editorconfig.js"
    },
    "testMatch": [
      "<rootDir>/**/__tests__/*.ts"
    ],
    "collectCoverageFrom": [
      "**/*.ts",
      "!**/__test__/*",
      "!testing/*"
    ],
    "coverageReporters": [
      "text-summary",
      "lcov",
      "html"
    ]
  },
  "dependencies": {
    "fast-glob": "3.3.3",
    "fuzzy-search": "3.2.1",
    "node-fetch": "2.7.0",
    "turndown": "7.2.2",
    "web-tree-sitter": "0.23.0",
    "zod": "3.25.76"
  }
}