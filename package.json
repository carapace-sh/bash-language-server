{
  "private": true,
  "scripts": {
    "clean": "rm -rf *.log */*.log */out node_modules server/node_modules",
    "compile": "tsc -b && cp server/src/get-options.sh server/out/",
    "build:bundle": "cd server && bun build --compile --target node --outfile bash-language-server out/cli.js",
    "watch": "tsc -b -w",
    "lint": "bun run lint:bail --fix",
    "lint:bail": "eslint . --ext js,ts,tsx --cache",
    "test": "bun test --isolate",
    "test:coverage": "bun test --isolate --coverage",
    "test:watch": "bun run test --watch",
    "verify": "bun run lint && bun run compile && bun run test",
    "verify:bail": "bun run lint:bail && bun run compile && bun run test:coverage",
    "reinstall-server": "bun pm uninstall -g bash-language-server && bun run compile && bun pm install -g ./server",
    "link-server": "bun pm uninstall -g bash-language-server && bun run compile && bun pm link ./server",
    "postinstall": "bun install --cwd server"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/node": "22.15.29",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "cross-spawn": ">=7.0.5",
    "eslint": "8.57.1",
    "eslint-config-prettier": "9.1.2",
    "eslint-plugin-jest": "28.14.0",
    "eslint-plugin-prettier": "4.2.5",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "eslint-plugin-sort-class-members": "1.21.0",
    "jest": "29.7.0",
    "prettier": "2.8.8",
    "ts-jest": "29.4.5",
    "typescript": "5.9.3",
    "vscode-languageserver": "8.0.2",
    "vscode-languageserver-textdocument": "1.0.12"
  },
  "resolutions": {
    "@types/vscode": "1.106.1"
  },
  "engines": {
    "node": ">=20"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "clearMocks": true,
    "moduleFileExtensions": [
      "js",
      "json",
      "node",
      "ts"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/server/out"
    ],
    "transform": {
      "\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "./server/tsconfig.json"
        }
      ]
    },
    "moduleNameMapper": {
      "^tiny-editorconfig$": "<rootDir>/__mocks__/tiny-editorconfig.js"
    },
    "testMatch": [
      "<rootDir>/**/__tests__/*.ts"
    ],
    "collectCoverageFrom": [
      "**/*.ts",
      "!**/__test__/*",
      "!testing/*"
    ],
    "coverageReporters": [
      "text-summary",
      "lcov",
      "html"
    ]
  }
}
